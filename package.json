{
  "name": "aura-music-android",
  "version": "1.0.0",
  "private": true,
  "description": "Aura Music Android application",
  "scripts": {
    "build:web": "node scripts/copy-web.mjs",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npm run build:web && npx cap sync android",
    "android:debug": "npm run cap:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0"
  }
}